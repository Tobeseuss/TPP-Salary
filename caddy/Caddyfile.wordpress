# Caddyfile وردپرس — fastcgi به کانتینر php-fpm
# (این فایل را با نام Caddyfile در کنار docker-compose.yml قرار دهید
#  یا در docker-compose به آن اشاره کنید)

:80 {
	root * /var/www/html

	php_fastcgi wordpress:9000 {
		root /var/www/html
	}

	file_server

	encode gzip

	# آپلود فایل‌های بزرگ (بکاپ/ورود گروهی اکسل)
	request_body {
		max_size 64MB
	}
}
